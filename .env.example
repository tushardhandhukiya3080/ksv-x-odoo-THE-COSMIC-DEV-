# ──────────────────────────────────────────────────────────────
# VendorBridge environment — copy to .env and fill in real values
# NEVER commit .env. Only .env.example is tracked.
# ──────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (Postgres)
POSTGRES_USER=vendorbridge
POSTGRES_PASSWORD=vendorbridge_dev_pw
POSTGRES_DB=vendorbridge
DATABASE_URL=postgresql://vendorbridge:vendorbridge_dev_pw@localhost:5432/vendorbridge?schema=public

# Redis (cache, BullMQ, rate-limit)
REDIS_URL=redis://localhost:6379

# Meilisearch (instant search)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=meili_dev_master_key_change_me

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=vendorbridge
MINIO_SECRET_KEY=vendorbridge_dev_secret
MINIO_BUCKET=vendorbridge

# Auth / JWT  (generate with: openssl rand -hex 48)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Payments (Razorpay — use TEST keys for the demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI (LlmService — Anthropic Claude or OpenAI)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-latest

# Automation (n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vendorbridge
N8N_WEBHOOK_SECRET=change_me_n8n_shared_secret

# WhatsApp (Cloud API or Twilio)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Audit-ledger anchoring (Polygon Amoy testnet — optional)
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=

# Maps (free, no key)
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Frontend public vars
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
