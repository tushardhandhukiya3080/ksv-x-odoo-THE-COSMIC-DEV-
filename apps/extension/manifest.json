{
  "manifest_version": 3,
  "name": "VendorBridge Sidekick",
  "version": "1.0.0",
  "description": "Companion extension for the VendorBridge Procurement ERP — real-time notifications, context-menu document ingestion, and a developer role-switcher panel.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VendorBridge Sidekick"
  },

  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "notifications",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vendorbridge.io/*",
    "https://*.vendorbridge.com/*",
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
