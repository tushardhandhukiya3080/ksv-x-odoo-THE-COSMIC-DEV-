# ──────────────────────────────────────────────────────────────
# VendorBridge PRODUCTION env — copy to .env.production on the VPS and fill in.
# NEVER commit the real file. Used by docker-compose.prod.yml.
# ──────────────────────────────────────────────────────────────

# Your domain (no subdomain). App is served at app.<DOMAIN>, API at api.<DOMAIN>.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Postgres
POSTGRES_USER=vendorbridge
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vendorbridge

# JWT secrets — generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME_meili_key

# MinIO object storage
MINIO_ACCESS_KEY=vendorbridge
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET=vendorbridge

# Seed demo data on the FIRST deploy only, then set back to false.
SEED_ON_START=true

# ---- Optional integrations (leave blank to degrade gracefully) ----
# AI (live recommendation instead of deterministic fallback)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-latest

# Razorpay (test or live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# n8n / WhatsApp
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
